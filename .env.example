# Only use a domain you own or a synthetic domain; .example is reserved for demonstrations.
TARGET_DOMAIN=acme-demo.example
DATABASE_URL=postgresql+psycopg://leakwatch:dev-only-change-me@localhost:5432/leakwatch
POSTGRES_USER=leakwatch
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_DB=leakwatch
# Comma-separated public raw paste URLs. Examples (replace ID with an authorized public paste):
# PASTE_URLS=https://pastebin.com/raw/PASTE_ID,https://rentry.co/raw/PASTE_ID
PASTE_URLS=
# Optional: Telegram API from my.telegram.org. Keep all values private.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Public channel usernames, comma-separated (no @ required). Only monitor channels permitted to you.
TELEGRAM_CHANNELS=
# Optional HTTPS alert receiver (no raw evidence is sent)
WEBHOOK_URL=
